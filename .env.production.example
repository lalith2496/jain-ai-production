# =========================
# Backend / Render
# =========================

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jainai

# During first deployment with Vercel URLs:
ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app,https://YOUR-ADMIN.vercel.app

TAVILY_API_KEY=
YOUTUBE_API_KEY=
WEB_SEARCH_MODE=always

# Local Ollama:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_API_KEY=

# Recommended first public beta: Ollama Cloud
OLLAMA_URL=https://ollama.com
OLLAMA_MODEL=CHOOSE_A_MODEL_RETURNED_BY_OLLAMA_CLOUD
OLLAMA_API_KEY=

ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Use true + none when admin frontend and API are on different provider domains.
ADMIN_COOKIE_SECURE=true
ADMIN_COOKIE_SAMESITE=none

CRAWLER_ALLOWED_PORTS=80,443
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MAX_BYTES=2000000
